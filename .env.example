# Copy to .env and fill in. .env is gitignored.

# "prod" or "demo". Use demo for any order-placement testing.
NBA_KALSHI_ENV=prod

# Kalshi API key (create one under Account settings > API keys on kalshi.com).
# Leave blank to run the recorder in public REST polling mode (no WebSocket).
NBA_KALSHI_KEY_ID=
# Absolute path to the private key file Kalshi gave you. Keep it OUTSIDE this repo.
NBA_KALSHI_PRIVATE_KEY_PATH=

# Where recorded data goes (gitignored)
NBA_DATA_DIR=data

# Max Kalshi REST requests per second. Unauthenticated traffic 429s above ~5/s;
# an API key gets a higher read budget (check GET /account/limits).
NBA_KALSHI_MAX_RPS=4
